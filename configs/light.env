# Training defaults for the independent 301-candidate light dataset.
if [[ -z "${SKILLRET_ROOT:-}" ]]; then
  SKILLRET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

DATASET_DIR="${DATASET_DIR:-data_light/final}"
RUN_DIR="${RUN_DIR:-runs/light301-qwen3-1.7b-full-v1}"
PROCESSED_DIR="${PROCESSED_DIR:-$RUN_DIR/processed}"
EMBEDDING_DIR="${EMBEDDING_DIR:-$RUN_DIR/embeddings}"
PREPARE_SCRIPT="${PREPARE_SCRIPT:-scripts/prepare_clawhub.py}"
CODE_SPLITS="${CODE_SPLITS:-train}"

EMBEDDING_MODEL="${EMBEDDING_MODEL:-Qwen/Qwen3-Embedding-8B}"
ROUTER_MODEL="${ROUTER_MODEL:-Qwen/Qwen3-1.7B}"
NUM_LEVELS="${NUM_LEVELS:-2}"
BRANCHING_FACTORS="${BRANCHING_FACTORS:-32 16}"
SK_EPSILONS="${SK_EPSILONS:-0.003 0.01}"
RQ_LAYERS="${RQ_LAYERS:-512 256 128 64}"
TOKENIZER_BETA="${TOKENIZER_BETA:-2.25}"
TOKENIZER_BATCH_SIZE="${TOKENIZER_BATCH_SIZE:-96}"
TOKENIZER_EPOCHS="${TOKENIZER_EPOCHS:-1200}"
TOKENIZER_LR="${TOKENIZER_LR:-1e-5}"
TOKENIZER_SCHEDULER="${TOKENIZER_SCHEDULER:-constant}"
TOKENIZER_WARMUP_RATIO="${TOKENIZER_WARMUP_RATIO:-0.01}"
TOKENIZER_EVAL_EVERY="${TOKENIZER_EVAL_EVERY:-10}"
CODEBOOK_VERSION="${CODEBOOK_VERSION:-light301-v1}"
CODE_ASSIGNMENT_MODE="${CODE_ASSIGNMENT_MODE:-balanced_hierarchical}"
CODE_ASSIGNMENT_EXACT_GROUP_SIZE="${CODE_ASSIGNMENT_EXACT_GROUP_SIZE:-512}"
CODE_QUALITY_GATE_SPLIT="${CODE_QUALITY_GATE_SPLIT:-train}"
CODE_MAX_COLLISION_RATE="${CODE_MAX_COLLISION_RATE:-0.01}"
CODE_MAX_RAW_COLLISION_RATE="${CODE_MAX_RAW_COLLISION_RATE:-0.20}"
CODE_MAX_BUCKET_SIZE="${CODE_MAX_BUCKET_SIZE:-2}"
CODE_MIN_LEVEL_UTILIZATION="${CODE_MIN_LEVEL_UTILIZATION:-0.75}"
CODE_MIN_NORMALIZED_ENTROPY="${CODE_MIN_NORMALIZED_ENTROPY:-0.80}"
CODE_MIN_RAW_LEVEL_UTILIZATION="${CODE_MIN_RAW_LEVEL_UTILIZATION:-0.50 0.45}"
CODE_MIN_RAW_NORMALIZED_ENTROPY="${CODE_MIN_RAW_NORMALIZED_ENTROPY:-0.65}"

EMBEDDING_BATCH_SIZE="${EMBEDDING_BATCH_SIZE:-8}"
EMBEDDING_MAX_BATCH_CHARS="${EMBEDDING_MAX_BATCH_CHARS:-12000}"
EMBEDDING_MAX_SKILL_CHARS="${EMBEDDING_MAX_SKILL_CHARS:-1400}"
ROUTER_VALIDATION_FRACTION="${ROUTER_VALIDATION_FRACTION:-0.05}"
ROUTER_FINETUNE_MODE="${ROUTER_FINETUNE_MODE:-full}"
ROUTER_MEMORIZATION_EPOCHS="${ROUTER_MEMORIZATION_EPOCHS:-10}"
ROUTER_ALIGNMENT_EPOCHS="${ROUTER_ALIGNMENT_EPOCHS:-3}"
ROUTER_ALIGNMENT_LR="${ROUTER_ALIGNMENT_LR:-2e-5}"
ROUTER_RETRIEVAL_EPOCHS="${ROUTER_RETRIEVAL_EPOCHS:-15}"
ROUTER_RETRIEVAL_REPLAY_FRACTION="${ROUTER_RETRIEVAL_REPLAY_FRACTION:-0.20}"
ROUTER_SAVE_STEPS="${ROUTER_SAVE_STEPS:-25}"
ROUTER_EVAL_STEPS="${ROUTER_EVAL_STEPS:-25}"
EVAL_PROTOCOL="${EVAL_PROTOCOL:-closedset}"
QUERY_SET="${QUERY_SET:-test}"

# shellcheck source=configs/skillret.env
source "$SKILLRET_ROOT/configs/skillret.env"
