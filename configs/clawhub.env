# Defaults for the versioned ClawHub closed-set routing dataset.
# On another machine, normally only these model locations need changing.
if [[ -z "${SKILLRET_ROOT:-}" ]]; then
  SKILLRET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi
EMBEDDING_MODEL="${EMBEDDING_MODEL:-Qwen/Qwen3-Embedding-8B}"
ROUTER_MODEL="${ROUTER_MODEL:-Qwen/Qwen3-1.7B}"

DATASET_DIR="${DATASET_DIR:-data/clawhub_training/final}"
RUN_DIR="${RUN_DIR:-runs/clawhub}"
PREPARE_SCRIPT="${PREPARE_SCRIPT:-scripts/prepare_clawhub.py}"
CODE_SPLITS="${CODE_SPLITS:-train}"

# 16^3=4096 paths for 1,000 candidates: enough headroom without the 192-token
# namespace used by the 64/64/64 SkillRet default.
NUM_LEVELS="${NUM_LEVELS:-3}"
BRANCHING_FACTORS="${BRANCHING_FACTORS:-16 16 16}"
SK_EPSILONS="${SK_EPSILONS:-0 0 0.01}"
TOKENIZER_BATCH_SIZE="${TOKENIZER_BATCH_SIZE:-256}"
TOKENIZER_EPOCHS="${TOKENIZER_EPOCHS:-100}"
CODEBOOK_VERSION="${CODEBOOK_VERSION:-clawhub-v1}"

# Candidate descriptions are short, but cap aggregate request characters so
# an OpenAI-compatible embedding server never receives an oversized batch.
EMBEDDING_BATCH_SIZE="${EMBEDDING_BATCH_SIZE:-8}"
EMBEDDING_MAX_BATCH_CHARS="${EMBEDDING_MAX_BATCH_CHARS:-12000}"

# 3,353 training queries yield roughly 9.7k retrieval targets before code
# collisions. Four GPUs x batch 1 x accumulation 8 gives global batch 32.
ROUTER_VALIDATION_FRACTION="${ROUTER_VALIDATION_FRACTION:-0.02}"
ROUTER_MEMORIZATION_EPOCHS="${ROUTER_MEMORIZATION_EPOCHS:-3}"
ROUTER_RETRIEVAL_EPOCHS="${ROUTER_RETRIEVAL_EPOCHS:-3}"
ROUTER_SAVE_STEPS="${ROUTER_SAVE_STEPS:-50}"
ROUTER_EVAL_STEPS="${ROUTER_EVAL_STEPS:-50}"

# Evaluate the uploaded test queries against the same 1,000-skill candidate set.
EVAL_PROTOCOL="${EVAL_PROTOCOL:-closedset}"
QUERY_SET="${QUERY_SET:-test}"

# Reuse CUDA, LoRA/full-finetuning, four-GPU ZeRO-3, and inference defaults.
# Variables already set above are preserved by the base configuration.
# shellcheck source=configs/skillret.env
source "$SKILLRET_ROOT/configs/skillret.env"
