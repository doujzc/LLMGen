# Overrides for the versioned 1000-candidate ClawHub closed-set dataset.
if [[ -z "${SKILLRET_ROOT:-}" ]]; then
  SKILLRET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

DATASET_DIR="${DATASET_DIR:-data/clawhub_training/final}"
DATASET_NAME="${DATASET_NAME:-clawhub-top1000-router-v1}"
RUN_DIR="${RUN_DIR:-runs/clawhub-top1000-qwen3-1.7b-full-v1}"
PROCESSED_DIR="${PROCESSED_DIR:-$RUN_DIR/processed}"
EMBEDDING_DIR="${EMBEDDING_DIR:-$RUN_DIR/embeddings}"

# 128^2 paths preserve ToolWeaver-like spare capacity while every Skill still
# uses exactly two generated tokens.
BRANCHING_FACTORS="${BRANCHING_FACTORS:-128 128}"
RQ_LAYERS="${RQ_LAYERS:-1024 512 256 128 64}"
TOKENIZER_BATCH_SIZE="${TOKENIZER_BATCH_SIZE:-1000}"
TOKENIZER_EPOCHS="${TOKENIZER_EPOCHS:-2000}"
CODEBOOK_VERSION="${CODEBOOK_VERSION:-clawhub-v3}"
CODE_ASSIGNMENT_EXACT_GROUP_SIZE="${CODE_ASSIGNMENT_EXACT_GROUP_SIZE:-2048}"

CODE_MAX_COLLISION_RATE="${CODE_MAX_COLLISION_RATE:-0.01}"
CODE_MAX_RAW_COLLISION_RATE="${CODE_MAX_RAW_COLLISION_RATE:-0.15}"
CODE_MIN_LEVEL_UTILIZATION="${CODE_MIN_LEVEL_UTILIZATION:-0.90}"
CODE_MIN_NORMALIZED_ENTROPY="${CODE_MIN_NORMALIZED_ENTROPY:-0.90}"
CODE_MIN_RAW_LEVEL_UTILIZATION="${CODE_MIN_RAW_LEVEL_UTILIZATION:-0.75 0.65}"
CODE_MIN_RAW_NORMALIZED_ENTROPY="${CODE_MIN_RAW_NORMALIZED_ENTROPY:-0.80}"

ROUTER_VALIDATION_FRACTION="${ROUTER_VALIDATION_FRACTION:-0.02}"
ROUTER_SAVE_STEPS="${ROUTER_SAVE_STEPS:-50}"
ROUTER_EVAL_STEPS="${ROUTER_EVAL_STEPS:-50}"

# shellcheck source=configs/closedset.env
source "$SKILLRET_ROOT/configs/closedset.env"
