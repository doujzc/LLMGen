# Defaults for the versioned ClawHub closed-set routing dataset.
# On another machine, normally only these model locations need changing.
if [[ -z "${SKILLRET_ROOT:-}" ]]; then
  SKILLRET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi
EMBEDDING_MODEL="${EMBEDDING_MODEL:-Qwen/Qwen3-Embedding-8B}"
ROUTER_MODEL="${ROUTER_MODEL:-Qwen/Qwen3-1.7B}"

DATASET_DIR="${DATASET_DIR:-data/clawhub_training/final}"
RUN_DIR="${RUN_DIR:-runs/clawhub}"
PREPARE_SCRIPT="${PREPARE_SCRIPT:-scripts/prepare_clawhub.py}"
CODE_SPLITS="${CODE_SPLITS:-train}"

# 128^2=16,384 paths keeps ToolWeaver-like spare capacity while every skill
# still uses exactly two generated code tokens.
NUM_LEVELS="${NUM_LEVELS:-2}"
BRANCHING_FACTORS="${BRANCHING_FACTORS:-128 128}"
SK_EPSILONS="${SK_EPSILONS:-0.003 0.01}"
RQ_LAYERS="${RQ_LAYERS:-1024 512 256 128 64}"
TOKENIZER_BETA="${TOKENIZER_BETA:-2.25}"
TOKENIZER_BATCH_SIZE="${TOKENIZER_BATCH_SIZE:-1000}"
TOKENIZER_EPOCHS="${TOKENIZER_EPOCHS:-2000}"
TOKENIZER_LR="${TOKENIZER_LR:-1e-5}"
TOKENIZER_SCHEDULER="${TOKENIZER_SCHEDULER:-constant}"
TOKENIZER_WARMUP_RATIO="${TOKENIZER_WARMUP_RATIO:-0.01}"
TOKENIZER_EVAL_EVERY="${TOKENIZER_EVAL_EVERY:-10}"
CODEBOOK_VERSION="${CODEBOOK_VERSION:-clawhub-v3}"

# Hard global balancing plus prefix-local uniqueness uses the learned RQ
# distances and guarantees a unique two-token path at this capacity. Raw
# nearest metrics remain gated so post-processing cannot hide a bad codebook.
CODE_ASSIGNMENT_MODE="${CODE_ASSIGNMENT_MODE:-balanced_hierarchical}"
CODE_ASSIGNMENT_EXACT_GROUP_SIZE="${CODE_ASSIGNMENT_EXACT_GROUP_SIZE:-2048}"
CODE_QUALITY_GATE_SPLIT="${CODE_QUALITY_GATE_SPLIT:-train}"
CODE_MAX_COLLISION_RATE="${CODE_MAX_COLLISION_RATE:-0.01}"
CODE_MAX_RAW_COLLISION_RATE="${CODE_MAX_RAW_COLLISION_RATE:-0.15}"
CODE_MAX_BUCKET_SIZE="${CODE_MAX_BUCKET_SIZE:-2}"
CODE_MIN_LEVEL_UTILIZATION="${CODE_MIN_LEVEL_UTILIZATION:-0.90}"
CODE_MIN_NORMALIZED_ENTROPY="${CODE_MIN_NORMALIZED_ENTROPY:-0.90}"
CODE_MIN_RAW_LEVEL_UTILIZATION="${CODE_MIN_RAW_LEVEL_UTILIZATION:-0.75 0.65}"
CODE_MIN_RAW_NORMALIZED_ENTROPY="${CODE_MIN_RAW_NORMALIZED_ENTROPY:-0.80}"

# Candidate descriptions are short, but cap aggregate request characters so
# an OpenAI-compatible embedding server never receives an oversized batch.
EMBEDDING_BATCH_SIZE="${EMBEDDING_BATCH_SIZE:-8}"
EMBEDDING_MAX_BATCH_CHARS="${EMBEDDING_MAX_BATCH_CHARS:-12000}"

# Each of the 3,353 training queries is one ordered multi-code target sequence.
# Four GPUs x batch 1 x accumulation 8 gives global batch 32.
ROUTER_VALIDATION_FRACTION="${ROUTER_VALIDATION_FRACTION:-0.02}"
ROUTER_MEMORIZATION_EPOCHS="${ROUTER_MEMORIZATION_EPOCHS:-10}"
ROUTER_RETRIEVAL_EPOCHS="${ROUTER_RETRIEVAL_EPOCHS:-15}"
ROUTER_RETRIEVAL_REPLAY_FRACTION="${ROUTER_RETRIEVAL_REPLAY_FRACTION:-0.20}"
ROUTER_SAVE_STEPS="${ROUTER_SAVE_STEPS:-50}"
ROUTER_EVAL_STEPS="${ROUTER_EVAL_STEPS:-50}"

# Evaluate the uploaded test queries against the same 1,000-skill candidate set.
EVAL_PROTOCOL="${EVAL_PROTOCOL:-closedset}"
QUERY_SET="${QUERY_SET:-test}"

# Reuse CUDA, LoRA/full-finetuning, four-GPU ZeRO-3, and inference defaults.
# Variables already set above are preserved by the base configuration.
# shellcheck source=configs/skillret.env
source "$SKILLRET_ROOT/configs/skillret.env"
