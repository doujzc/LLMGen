# Shared defaults for scripts/skillret/*.sh.
# On a new machine, normally only these two model locations need changing.
EMBEDDING_MODEL="${EMBEDDING_MODEL:-Qwen/Qwen3-Embedding-8B}"
ROUTER_MODEL="${ROUTER_MODEL:-Qwen/Qwen3-1.7B}"

# Runtime and artifact locations. Prefer the repo venv, otherwise use the active
# Conda/system environment. Relative artifact paths are resolved from the repo root.
if [[ -z "${PYTHON:-}" ]]; then
  if [[ -x "$SKILLRET_ROOT/.venv/bin/python" ]]; then
    PYTHON="$SKILLRET_ROOT/.venv/bin/python"
  else
    PYTHON=python
  fi
fi
DATASET_DIR="${DATASET_DIR:-data/skillret}"
PROCESSED_DIR="${PROCESSED_DIR:-$DATASET_DIR/processed}"
EMBEDDING_DIR="${EMBEDDING_DIR:-$DATASET_DIR/embeddings}"
RUN_DIR="${RUN_DIR:-runs/skillret}"
STAGE1_DIR="${STAGE1_DIR:-$RUN_DIR/stage1}"
INDEX_DIR="${INDEX_DIR:-$RUN_DIR/index}"
ROUTER_DATA_DIR="${ROUTER_DATA_DIR:-$RUN_DIR/router_data}"
ROUTER_OUTPUT_DIR="${ROUTER_OUTPUT_DIR:-$RUN_DIR/router}"
DEVICE="${DEVICE:-cuda}"

# Step 01: normalize SkillRet and call an OpenAI-compatible embedding endpoint.
EMBEDDING_PROVIDER="${EMBEDDING_PROVIDER:-openai}"
EMBEDDING_BASE_URL="${EMBEDDING_BASE_URL:-${OPENAI_BASE_URL:-http://127.0.0.1:8000/v1}}"
EMBEDDING_BATCH_SIZE="${EMBEDDING_BATCH_SIZE:-8}"
EMBEDDING_DIMENSIONS="${EMBEDDING_DIMENSIONS:-}"
EMBEDDING_TIMEOUT="${EMBEDDING_TIMEOUT:-600}"
EMBEDDING_MAX_RETRIES="${EMBEDDING_MAX_RETRIES:-5}"

# Step 02: ToolWeaver-style learned balanced hierarchical tokenizer.
NUM_LEVELS="${NUM_LEVELS:-3}"
BRANCHING_FACTORS="${BRANCHING_FACTORS:-64 64 64}"
SK_EPSILONS="${SK_EPSILONS:-0 0 0.01}"
RQ_LAYERS="${RQ_LAYERS:-512 256 128}"
TOKENIZER_E_DIM="${TOKENIZER_E_DIM:-64}"
TOKENIZER_EPOCHS="${TOKENIZER_EPOCHS:-100}"
TOKENIZER_BATCH_SIZE="${TOKENIZER_BATCH_SIZE:-512}"
TOKENIZER_LR="${TOKENIZER_LR:-1e-4}"
TOKENIZER_GRAPH_LAMBDA="${TOKENIZER_GRAPH_LAMBDA:-0.001}"
TOKENIZER_AMP_DTYPE="${TOKENIZER_AMP_DTYPE:-bf16}"
CODEBOOK_VERSION="${CODEBOOK_VERSION:-skillret-v1}"
TOKENIZER_RESUME="${TOKENIZER_RESUME:-}"
CODE_EXPORT_BATCH_SIZE="${CODE_EXPORT_BATCH_SIZE:-512}"

# Step 04: closed-set query split. Every train skill remains in the candidate set.
MEMORIZATION_VALIDATION_FRACTION="${MEMORIZATION_VALIDATION_FRACTION:-0}"
ROUTER_VALIDATION_FRACTION="${ROUTER_VALIDATION_FRACTION:-0.02}"
ROUTER_DATA_SEED="${ROUTER_DATA_SEED:-42}"

# Steps 05/06: Qwen router SFT. Defaults are one-node, four-GPU ZeRO-3 LoRA.
ROUTER_FINETUNE_MODE="${ROUTER_FINETUNE_MODE:-lora}"
ROUTER_NUM_GPUS="${ROUTER_NUM_GPUS:-4}"
ROUTER_DEEPSPEED_CONFIG="${ROUTER_DEEPSPEED_CONFIG:-configs/deepspeed_zero3.json}"
ROUTER_PER_DEVICE_TRAIN_BATCH_SIZE="${ROUTER_PER_DEVICE_TRAIN_BATCH_SIZE:-1}"
ROUTER_PER_DEVICE_EVAL_BATCH_SIZE="${ROUTER_PER_DEVICE_EVAL_BATCH_SIZE:-4}"
ROUTER_GRADIENT_ACCUMULATION_STEPS="${ROUTER_GRADIENT_ACCUMULATION_STEPS:-8}"
ROUTER_MAX_LENGTH="${ROUTER_MAX_LENGTH:-1024}"
ROUTER_MEMORIZATION_EPOCHS="${ROUTER_MEMORIZATION_EPOCHS:-1}"
ROUTER_RETRIEVAL_EPOCHS="${ROUTER_RETRIEVAL_EPOCHS:-3}"
ROUTER_MEMORIZATION_LR="${ROUTER_MEMORIZATION_LR:-2e-5}"
ROUTER_RETRIEVAL_LR="${ROUTER_RETRIEVAL_LR:-2e-5}"
ROUTER_WEIGHT_DECAY="${ROUTER_WEIGHT_DECAY:-0}"
ROUTER_WARMUP_RATIO="${ROUTER_WARMUP_RATIO:-0.03}"
ROUTER_LOGGING_STEPS="${ROUTER_LOGGING_STEPS:-10}"
ROUTER_SAVE_STEPS="${ROUTER_SAVE_STEPS:-500}"
ROUTER_EVAL_STEPS="${ROUTER_EVAL_STEPS:-500}"
ROUTER_SAVE_TOTAL_LIMIT="${ROUTER_SAVE_TOTAL_LIMIT:-2}"
ROUTER_DATALOADER_NUM_WORKERS="${ROUTER_DATALOADER_NUM_WORKERS:-0}"
ROUTER_SEED="${ROUTER_SEED:-42}"
ROUTER_PRECISION="${ROUTER_PRECISION:-bf16}"
ROUTER_GRADIENT_CHECKPOINTING="${ROUTER_GRADIENT_CHECKPOINTING:-1}"
ROUTER_GRADIENT_CHECKPOINTING_MODE="${ROUTER_GRADIENT_CHECKPOINTING_MODE:-auto}"
ROUTER_TRUST_REMOTE_CODE="${ROUTER_TRUST_REMOTE_CODE:-0}"
ROUTER_LORA_R="${ROUTER_LORA_R:-16}"
ROUTER_LORA_ALPHA="${ROUTER_LORA_ALPHA:-32}"
ROUTER_LORA_DROPOUT="${ROUTER_LORA_DROPOUT:-0.05}"
ROUTER_LORA_TARGET_MODULES="${ROUTER_LORA_TARGET_MODULES:-q_proj,k_proj,v_proj,o_proj}"
ROUTER_LORA_MODULES_TO_SAVE="${ROUTER_LORA_MODULES_TO_SAVE:-auto}"
ROUTER_RESUME_MEMORIZATION="${ROUTER_RESUME_MEMORIZATION:-}"
ROUTER_RESUME_RETRIEVAL="${ROUTER_RESUME_RETRIEVAL:-}"
# Backward-compatible escape hatch; direct CLI arguments to a stage are preferred.
ROUTER_EXTRA_ARGS="${ROUTER_EXTRA_ARGS:-}"

# Step 07: constrained generation and retrieval evaluation.
EVAL_PROTOCOL="${EVAL_PROTOCOL:-closedset}"
QUERY_SET="${QUERY_SET:-validation}"
EVAL_DTYPE="${EVAL_DTYPE:-${DTYPE:-bfloat16}}"
EVAL_BATCH_SIZE="${EVAL_BATCH_SIZE:-${BATCH_SIZE:-1}}"
EVAL_BEAM_SIZE="${EVAL_BEAM_SIZE:-${BEAM_SIZE:-20}}"
EVAL_NUM_CODE_PATHS="${EVAL_NUM_CODE_PATHS:-${NUM_CODE_PATHS:-20}}"
EVAL_TOP_K="${EVAL_TOP_K:-${TOP_K:-20}}"
EVAL_CUTOFFS="${EVAL_CUTOFFS:-${CUTOFFS:-1 5 10}}"

# Optional vLLM embedding server defaults.
VLLM_HOST="${VLLM_HOST:-127.0.0.1}"
VLLM_PORT="${VLLM_PORT:-8000}"
VLLM_DTYPE="${VLLM_DTYPE:-auto}"
VLLM_MAX_MODEL_LEN="${VLLM_MAX_MODEL_LEN:-32768}"
VLLM_TENSOR_PARALLEL_SIZE="${VLLM_TENSOR_PARALLEL_SIZE:-1}"
