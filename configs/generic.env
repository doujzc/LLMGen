# Shared, dataset-neutral defaults for the generic candidate pipeline.
#
# Every candidate-, path-, code-, training-, and evaluation-specific value is
# supplied by ``src/llmgen/pipeline/stages/legacy.py`` from the immutable
# resolved pipeline configuration. This file only provides the common
# SkillRet defaults expected by the backwards-compatible shell stages.
if [[ -z "${SKILLRET_ROOT:-}" ]]; then
  SKILLRET_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

# shellcheck source=configs/closedset.env
source "$SKILLRET_ROOT/configs/closedset.env"
