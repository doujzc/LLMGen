# Generic multi-turn, direct candidate-name Top1 routing.

PYTHON="${PYTHON:-python}"
TOP1_DATA_DIR="${TOP1_DATA_DIR:-data_top1}"
TOP1_TRAIN_DATA="${TOP1_TRAIN_DATA:-$TOP1_DATA_DIR/train.jsonl}"
TOP1_VALIDATION_DATA="${TOP1_VALIDATION_DATA-$TOP1_DATA_DIR/validation.jsonl}"
TOP1_TEST_DATA="${TOP1_TEST_DATA-$TOP1_DATA_DIR/test.jsonl}"
TOP1_CANDIDATE_REGISTRY="${TOP1_CANDIDATE_REGISTRY:-configs/top1_candidates.json}"
TOP1_SYSTEM_PROMPT="${TOP1_SYSTEM_PROMPT:-configs/top1_system_prompt.md}"
TOP1_RUN_DIR="${TOP1_RUN_DIR:-runs/qwen3-1.7b-top1}"

# Usually the only machine-specific setting.
ROUTER_MODEL="${ROUTER_MODEL:-Qwen/Qwen3-1.7B}"
ROUTER_FINETUNE_MODE="${ROUTER_FINETUNE_MODE:-full}"
ROUTER_NUM_GPUS="${ROUTER_NUM_GPUS:-4}"
ROUTER_DEEPSPEED_CONFIG="${ROUTER_DEEPSPEED_CONFIG:-configs/deepspeed_zero3.json}"
ROUTER_PRECISION="${ROUTER_PRECISION:-bf16}"
ROUTER_MAX_LENGTH="${ROUTER_MAX_LENGTH:-1024}"
ROUTER_PER_DEVICE_TRAIN_BATCH_SIZE="${ROUTER_PER_DEVICE_TRAIN_BATCH_SIZE:-4}"
ROUTER_PER_DEVICE_EVAL_BATCH_SIZE="${ROUTER_PER_DEVICE_EVAL_BATCH_SIZE:-8}"
ROUTER_GRADIENT_ACCUMULATION_STEPS="${ROUTER_GRADIENT_ACCUMULATION_STEPS:-4}"
ROUTER_EPOCHS="${ROUTER_EPOCHS:-3}"
ROUTER_FULL_LEARNING_RATE="${ROUTER_FULL_LEARNING_RATE:-1e-5}"
ROUTER_LORA_LEARNING_RATE="${ROUTER_LORA_LEARNING_RATE:-2e-5}"
ROUTER_WEIGHT_DECAY="${ROUTER_WEIGHT_DECAY:-0.01}"
ROUTER_WARMUP_RATIO="${ROUTER_WARMUP_RATIO:-0.05}"
ROUTER_LOGGING_STEPS="${ROUTER_LOGGING_STEPS:-5}"
ROUTER_SAVE_STEPS="${ROUTER_SAVE_STEPS:-25}"
ROUTER_EVAL_STEPS="${ROUTER_EVAL_STEPS:-25}"
ROUTER_SAVE_TOTAL_LIMIT="${ROUTER_SAVE_TOTAL_LIMIT:-2}"
ROUTER_DATALOADER_NUM_WORKERS="${ROUTER_DATALOADER_NUM_WORKERS:-4}"
ROUTER_GRADIENT_CHECKPOINTING="${ROUTER_GRADIENT_CHECKPOINTING:-1}"
ROUTER_GRADIENT_CHECKPOINTING_MODE="${ROUTER_GRADIENT_CHECKPOINTING_MODE:-auto}"
ROUTER_TRUST_REMOTE_CODE="${ROUTER_TRUST_REMOTE_CODE:-0}"
ROUTER_RESUME="${ROUTER_RESUME:-}"
ROUTER_EXTRA_ARGS="${ROUTER_EXTRA_ARGS:-}"

INFERENCE_MODEL="${INFERENCE_MODEL:-$TOP1_RUN_DIR/router/retrieval}"
INFERENCE_BATCH_SIZE="${INFERENCE_BATCH_SIZE:-8}"
INFERENCE_DECODING_MODE="${INFERENCE_DECODING_MODE:-greedy}"
INFERENCE_NUM_BEAMS="${INFERENCE_NUM_BEAMS:-4}"
INFERENCE_DEVICE="${INFERENCE_DEVICE:-cuda:0}"
INFERENCE_DTYPE="${INFERENCE_DTYPE:-bfloat16}"
