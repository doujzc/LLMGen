# Direct candidate-name Top1 training.

PYTHON="${PYTHON:-.venv/bin/python}"
TOP1_TRAIN_DATA="${TOP1_TRAIN_DATA:-data_top1/train.jsonl}"
TOP1_VALIDATION_DATA="${TOP1_VALIDATION_DATA:-}"
TOP1_CANDIDATE_REGISTRY="${TOP1_CANDIDATE_REGISTRY:-configs/top1_candidates.json}"
TOP1_SYSTEM_PROMPT="${TOP1_SYSTEM_PROMPT:-configs/top1_system_prompt.md}"
TOP1_RUNS_ROOT="${TOP1_RUNS_ROOT:-runs/top1}"
TOP1_EXPERIMENT_NAME="${TOP1_EXPERIMENT_NAME:-qwen3-1.7b-top1}"
TOP1_RUN_ID="${TOP1_RUN_ID:-}"
TOP1_OUTPUT_DIR="${TOP1_OUTPUT_DIR:-}"

TOP1_MODEL="${TOP1_MODEL:-Qwen/Qwen3-1.7B}"
TOP1_FINETUNE_MODE="${TOP1_FINETUNE_MODE:-full}"
TOP1_NUM_GPUS="${TOP1_NUM_GPUS:-4}"
TOP1_DEEPSPEED_CONFIG="${TOP1_DEEPSPEED_CONFIG:-configs/deepspeed_zero3.json}"
TOP1_PRECISION="${TOP1_PRECISION:-bf16}"
TOP1_MAX_LENGTH="${TOP1_MAX_LENGTH:-1024}"
TOP1_PER_DEVICE_TRAIN_BATCH_SIZE="${TOP1_PER_DEVICE_TRAIN_BATCH_SIZE:-4}"
TOP1_PER_DEVICE_EVAL_BATCH_SIZE="${TOP1_PER_DEVICE_EVAL_BATCH_SIZE:-1}"
TOP1_EVAL_ACCUMULATION_STEPS="${TOP1_EVAL_ACCUMULATION_STEPS:-1}"
TOP1_GRADIENT_ACCUMULATION_STEPS="${TOP1_GRADIENT_ACCUMULATION_STEPS:-4}"
TOP1_EPOCHS="${TOP1_EPOCHS:-3}"
TOP1_FULL_LEARNING_RATE="${TOP1_FULL_LEARNING_RATE:-1e-5}"
TOP1_LORA_LEARNING_RATE="${TOP1_LORA_LEARNING_RATE:-2e-5}"
TOP1_WEIGHT_DECAY="${TOP1_WEIGHT_DECAY:-0.01}"
TOP1_WARMUP_RATIO="${TOP1_WARMUP_RATIO:-0.05}"
TOP1_LOGGING_STEPS="${TOP1_LOGGING_STEPS:-5}"
TOP1_SAVE_STEPS="${TOP1_SAVE_STEPS:-25}"
TOP1_EVAL_STEPS="${TOP1_EVAL_STEPS:-25}"
TOP1_SAVE_TOTAL_LIMIT="${TOP1_SAVE_TOTAL_LIMIT:-2}"
TOP1_DATALOADER_NUM_WORKERS="${TOP1_DATALOADER_NUM_WORKERS:-4}"
TOP1_SEED="${TOP1_SEED:-42}"
TOP1_GRADIENT_CHECKPOINTING="${TOP1_GRADIENT_CHECKPOINTING:-1}"
TOP1_GRADIENT_CHECKPOINTING_MODE="${TOP1_GRADIENT_CHECKPOINTING_MODE:-auto}"
TOP1_TRUST_REMOTE_CODE="${TOP1_TRUST_REMOTE_CODE:-0}"
TOP1_RESUME="${TOP1_RESUME:-}"
